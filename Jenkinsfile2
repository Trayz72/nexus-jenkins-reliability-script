pipeline {
    agent any
    parameters {

        string(name: 'SERVER_IP', defaultValue: '192.168.x.x', description: 'Your Laptop LAN IP (Do not use localhost)')
        choice(name: 'SERVER_PORT', choices: ['2221', '2222'], description: 'Target Docker SSH Port')
    }
    
    stages {
        stage('Transfer & Execute') {
            steps {
                script {
                  
                    def remote = [:]
                    remote.name = "docker-server"
                    remote.host = params.SERVER_IP
                    remote.port = params.SERVER_PORT.toInteger()
                    remote.allowAnyHosts = true 
                    
                    withCredentials([usernamePassword(credentialsId: 'ssh-creds', 
                                     passwordVariable: 'SSH_PASS', 
                                     usernameVariable: 'SSH_USER')]) {
                        
                        remote.user = SSH_USER
                        remote.password = SSH_PASS
                        
                        sshPut remote: remote, from: 'download.sh', into: '.'
                        

                        withCredentials([usernamePassword(credentialsId: 'nexus-credentials', 
                                         passwordVariable: 'NEXUS_PASS', 
                                         usernameVariable: 'NEXUS_USER')]) {
                            
                            sshCommand remote: remote, command: """
                                export NEXUS_USER='${NEXUS_USER}'
                                export NEXUS_PASS='${NEXUS_PASS}'
                                export NEXUS_IP='${params.SERVER_IP}'
                                chmod +x download.sh
                                ./download.sh 
                            """
                        }
                    }
                }
            }
        }
    }
}